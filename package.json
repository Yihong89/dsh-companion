{
  "name": "dsh-sister",
  "version": "0.1.0",
  "description": "DSH companion plugin: a warm, cheerful 'little sister' agent that speaks with a soft voice in the browser, auto-reads every reply aloud, fires scheduled daily cheers, and lifts the learner's mood with lots of positive emotion.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./register-events": {
      "default": "./lib/register-events.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "node --test 'test/*.test.js'"
  },
  "keywords": [
    "deepseek-harness",
    "deepseek",
    "dsh",
    "dsh-plugin",
    "cordis",
    "companion",
    "tts",
    "cheer",
    "motivation"
  ],
  "dependencies": {
    "zod": "^4.0.0",
    "dsh-voice-core": "github:Yihong89/dsh-voice-core"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "dsh-voice-core"
      ]
    }
  },
  "peerDependencies": {}
}
